# ========================================================
# Smart DevOps Assistant - Environment Configuration
# Copy this file to backend/.env or configure below
# ========================================================

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# AI LLM Providers (Optional - Leave blank to use built-in Offline DevOps Engine)
GROQ_API_KEY=
OPENAI_API_KEY=

# Local SQLite Database
DB_PATH=./devops_assistant.sqlite

# GitHub Cloud Integration (Real GitHub Actions & Repository connector)
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=DulaniLakmali
GITHUB_DEFAULT_REPO=Smart-DevOps-Assistant
