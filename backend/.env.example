# Server Port
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# LLM Providers (Optional - Leave blank to use built-in Offline DevOps Engine)
# Groq API Key (Free, fastest inference with Llama 3.3 70B)
GROQ_API_KEY=

# OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Database configuration
DB_PATH=./devops_assistant.sqlite

# GitHub Integration (Real GitHub Actions & Repository connector)
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=DulaniLakmali
GITHUB_DEFAULT_REPO=Smart-DevOps-Assistant
